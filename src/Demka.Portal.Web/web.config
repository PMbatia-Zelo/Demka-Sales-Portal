<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the Demka Sales Portal. Publish fills in processPath/arguments. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Demka.Portal.Web.dll" stdoutLogEnabled="false" stdoutLogFile="C:\DemkaPortal\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Ledger exports are large (40 MB in Oct 2026); allow up to 200 MB. -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
